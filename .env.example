# Upstash Redis credentials (Vercel's official storage option for free tier).
# Get these from Vercel dashboard → Storage → Marketplace → Upstash Redis.
# When you connect the integration to a project, these env vars auto-populate.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic API key — required for the "Generate next batch" feature.
# Get one at https://console.anthropic.com/settings/keys
# Add it in Vercel → Project Settings → Environment Variables.
ANTHROPIC_API_KEY=

# Legacy KV_* names also work — leave these unset unless you're using the
# older (deprecated) @vercel/kv integration on an existing project.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ─────────────────────────────────────────────────────────────
# Handoff — where "push a candidate" opens. No API keys needed;
# the app formats a row + copies it to clipboard, then opens
# these URLs in new tabs so you can paste + save manually.
# See SETUP-HANDOFF.md for what each URL should point at.
# ─────────────────────────────────────────────────────────────

# The Sourced Candidates spreadsheet — clicking "Paste into Sheet"
# in the handoff modal lands you here.
NEXT_PUBLIC_HANDOFF_SHEET_URL=

# The Engineering interview-feedback Google Doc (a single running
# document with a section per stage — "To be scheduled", "Initial
# Screen", etc.). Handoff generates a formatted block for you to
# paste under the right stage heading.
NEXT_PUBLIC_HANDOFF_DOC_URL=
